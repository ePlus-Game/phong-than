# ptfix plug-in of agent lenhbainv (2026-10-04): "Lenh Bai Nhiem Vu" (quest-NPC teleport token, 61430) and
# "Lenh Bai Tiep Te Nhiem Vu" (quest-item supply token, 61431).
# Server + Client: settings\item\001\magicscript.txt gets TWO rows (genre 6, detail 1, particular 61430 / 61431):
#   permanent, never consumed (the scripts never remove them), stack 1, no drop / trade / gamble / stall / sell,
#   scripts \script\phongthan\item\nhiemvu_lenhbai.lua / tiepte_lenhbai.lua (loose ASCII files generated by
#   scratchpad\lenhbainv\gen.py; shared data nhiemvu_data.lua).
# Columns cloned from the token row 61003 (build_ptfix.py TOKENS) or VNG 7308. Sprites: 61430 = VNG row 1439
# "Sat Ma Mat Lenh" (\spr\item\another\<token 1>.spr), 61431 = VNG row 33 "Chi Nam Phu" (purple scroll); each falls
# back to the other / the template when the sprite is missing from this side's PAKs.
# Idempotent: adds a row only if its particular is missing; patches on top of ctx["entries"] (other plug-ins'
# magicscript rows are kept). Doc: docs\features\lenh-bai-nhiem-vu-phong-than-20261004.md
import os

SCRIPT_NV = "\\script\\phongthan\\item\\nhiemvu_lenhbai.lua"
SCRIPT_TT = "\\script\\phongthan\\item\\tiepte_lenhbai.lua"
SCRIPT_TQ = "\\script\\phongthan\\item\\thamquan_lenhbai.lua"   # lenhbainv5: + row 61432 "Lenh Bai Tham Quan"
TOKENS = [
    (61430, "Lệnh Bài Nhiệm Vụ",
     "Nhấp phải: chọn nhiệm vụ tân thủ, chính tuyến, thế giới, hàng ngày, sự kiện hoặc Nhiệm vụ đang làm; dịch chuyển "
     "tới ngay cạnh NPC nhận/trả nhiệm vụ. Dùng vĩnh viễn, không mất.", SCRIPT_NV, (b"1439", b"33")),
    (61431, "Lệnh Bài Tiếp Tế Nhiệm Vụ",
     "Nhấp phải: chọn nhiệm vụ đang làm để nhận đủ vật phẩm nhiệm vụ còn thiếu của bước hiện tại (không phát tiền, "
     "không phát thưởng). Dùng vĩnh viễn, không mất.", SCRIPT_TT, (b"33", b"1439")),
    # lenhbainv5 (2026-10-04): Tham Quan token, sprite = VNG row 7010 "Lenh Bai Giai Dau" (fallback 1439)
    (61432, "Lệnh Bài Thám Quân",
     "Nhấp phải: tới điểm Thám Quân được giao (Đại Phu dã ngoại), đi lần lượt điểm còn thiếu, hoàn thành ngay điểm được "
     "giao hoặc về Hoàng Thiên Hóa trả nhiệm vụ. Dùng vĩnh viễn, không mất.", SCRIPT_TQ, (b"7010", b"1439")),
]


def _get(ctx, path):
    eid = ctx["h"](path)
    b = ctx["entries"].get(eid)
    if b is None:
        n, ent = ctx["effective"](eid)
        if not ent:
            return eid, None
        b = ctx["read_entry"](os.path.join(ctx["DATA"], n), ent)
    return eid, b


def _row(lines, key):
    for l in lines[1:]:
        c = l.rstrip(b"\r").split(b"\t")
        if len(c) > 3 and c[3] == key:
            return c
    return None


def apply(ctx):
    log = []
    eid, b = _get(ctx, "\\settings\\item\\001\\magicscript.txt")
    if b is None:
        ctx["log"]["lenhbainv"] = ["ERROR magicscript.txt missing"]
        return
    nl = b"\r\n" if b"\r\n" in b else b"\n"
    lines = b.rstrip(b"\r\n").split(nl)
    tc = ctx["tcvn"]
    added = 0
    for key, name, desc, script, sprite_rows in TOKENS:
        if _row(lines, str(key).encode()):
            log.append("already %d" % key)
            continue
        tpl = _row(lines, b"61003") or _row(lines, b"7308")
        ncol = max(34, len(tpl))
        tpl = tpl + [b""] * (ncol - len(tpl))
        c = list(tpl)
        spr = tpl[4]
        for sr in sprite_rows:
            r = _row(lines, sr)
            if not r or len(r) <= 4 or not r[4]:
                continue
            sid = ctx["h"](r[4].decode("gbk"))
            n, ent = ctx["effective"](sid)
            if ent or sid in ctx["entries"]:
                spr = r[4]
                break
            log.append("sprite of %s not in %s paks" % (sr.decode(), ctx["SIDE"]))
        c[0] = b"#<c=orange>" + tc(name) + b"<c>"
        c[1], c[2], c[3] = b"6", b"1", str(key).encode()
        c[4] = spr
        c[5], c[6], c[7] = b"39", b"1", b"1"
        c[8] = b"#" + tc(desc)
        c[9] = b""
        c[10] = b"1"
        c[12] = b"1"                          # stack 1
        c[13] = b"0"
        c[14] = script.encode("ascii")
        c[23] = b"0"                          # never consumed by the engine (the script does not remove it)
        c[24] = c[25] = c[26] = c[27] = b"0"  # no drop / trade / gamble / stall
        c[28] = b"0"                          # no PK drop
        c[29] = b""                           # permanent
        c[30] = b"0"                          # cannot sell to shop
        lines.append(b"\t".join(c[:ncol]))
        added += 1
        log.append("magicscript +%d sprite %s" % (key, spr.decode("gbk", "replace")))
    if added:
        ctx["entries"][eid] = nl.join(lines) + nl
    ctx["log"]["lenhbainv"] = log
