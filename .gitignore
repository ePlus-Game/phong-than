# Out-of-source CMake compile-only experiments
build/

# Prevent *new local* archive, runtime and build artifacts from entering Git.
# Historical tracked files require explicit cleanup (gitignore alone is insufficient).
/_backup/
/PhongThanSource/Output/
/PhongThanSource/OutputModern/
/PhongThanSource/Build/LogsModern/
/PhongThanRuntime-Staging/ControlLogs/
/PhongThanRuntime-Staging/Client/UserData/
/PhongThanRuntime-Staging/Client/Snapshot/
/PhongThanRuntime-Staging/Server/payserver_log/
/PhongThanRuntime-State/sql/
/AdminWeb/data/chest_backup/
/PhongThanRuntime-Staging/Server/CharacterStore/
/PhongThanRuntime-Staging/Server/database/
/PhongThanRuntime-Staging/Server/databasetong/
/PhongThanRuntime-Staging/Server/databasetongmember/
/PhongThanRuntime-Staging/Server/admin_bridge/heartbeat.txt
/PhongThanRuntime-Staging/Server/admin_bridge/online.txt
/PhongThanRuntime-Staging/Server/admin_bridge/pending.lua
/PhongThanRuntime-Staging/Server/admin_bridge/token.log
/PhongThanRuntime-Staging/Server/admin_bridge/result.log
/hygiene-summary.json

# New local runtime artifacts (historical tracked files are unaffected)
**/Debug/
**/x64/Debug/
**/Win32/Debug/
**/CMakeFiles/
**/CMakeCache.txt
**/compile_commands.json
*.VC.db-shm
*.VC.db-wal
*.dmp
*.stackdump
*.log.err
*.log.out
*.bak
*.old
*.orig
*.swp
*.swo
*.DS_Store
Thumbs.db
Desktop.ini
/.cache/
/tmp/
/temp/
/artifacts/
/reports/
/coverage/
/.hygiene/

# Local admin backups, previews and extracted package caches
/AdminWeb/*.backup-*
/AdminWeb/admin-ui-preview.png
/AdminWeb/data/git-update-backup/
/AdminWeb/data/history.json
/AdminWeb/data/bots.json
/AdminWeb/data/pak_item_tables/
__pycache__/
*.pyc

# Reassembled PAK files; tracked split parts remain the distribution source
/PhongThanRuntime-Staging/Client/data/*.pak
/PhongThanRuntime-Staging/Server/data/*.pak
/PhongThanRuntime-Staging/Server/admin_bridge/upgrade_items.txt

# Build products and live bridge status are recreated locally
**/Modern/
/PhongThanRuntime-Staging/Server/admin_bridge/*.txt
/PhongThanRuntime-Staging/Server/admin_bridge/*.log
